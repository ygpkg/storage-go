# Copy to .env.test and fill in actual values:
#   cp .env.test.example .env.test
#
# 使用 scripts/run_test.sh 运行测试，脚本会自动将对应驱动的前缀映射为 STORAGE_* 环境变量。

# === minio ===
MINIO_ENDPOINT=https://minio.example.com
MINIO_REGION=cn-xian
MINIO_ACCESS_KEY=xxx
MINIO_SECRET_KEY=xxx
MINIO_BUCKET=test-bucket
MINIO_BASE_DIR=storage-test

# === seaweedfs ===
SEAWEEDFS_ENDPOINT=https://seaweedfs.example.com
SEAWEEDFS_REGION=cn-xian
SEAWEEDFS_ACCESS_KEY=xxx
SEAWEEDFS_SECRET_KEY=xxx
SEAWEEDFS_BUCKET=test-bucket

# === cos ===
# 注意：COS_ENDPOINT 不要包含 bucket，正确的格式为 https://cos.<region>.myqcloud.com
COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
COS_REGION=ap-guangzhou
COS_ACCESS_KEY=xxx
COS_SECRET_KEY=xxx
COS_BUCKET=my-bucket-123456

# === local ===
# local 驱动可不配置，默认使用系统临时目录和 test-bucket
LOCAL_BUCKET=test
LOCAL_BASE_DIR=/tmp/storage-go-test